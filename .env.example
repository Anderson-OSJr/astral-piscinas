# Banco (docker compose up -d sobe um Postgres em localhost:5433)
DATABASE_URL="postgresql://astral:astral@localhost:5433/astral?schema=public"

# Gere com: npx auth secret   (ou qualquer string aleatória de 32+ caracteres)
AUTH_SECRET="troque-por-uma-string-aleatoria-com-32-caracteres"

# URL pública do site (sem barra no final)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Usados apenas pelo seed para criar o primeiro usuário do painel
ADMIN_EMAIL="admin@astralsolarepiscinas.com.br"
ADMIN_PASSWORD="troque-esta-senha"

# Opcional: tamanho do pool. Use 1 com o Postgres embutido (npm run db:local / prisma dev)
# DATABASE_POOL_MAX=1
